# Copy to .keys.env (gitignored) and fill in. Each role's key is handed ONLY to that role's process.
# Generate fresh keys:  for r in DEPLOYER OWNER AGENT COSIGNER GUARDIAN CLIENT VENDOR CREDITOR ADVERSARY HONEYPOT_AGENT HONEYPOT_OWNER HONEYPOT_COSIGNER; do echo "${r}_PK=$(cast wallet new --json | jq -r '.[0].private_key')"; done
DEPLOYER_PK=0x...      # funds every other role with gas; deploys the contracts
OWNER_PK=0x...         # cold key: signs mandates, ring-fences, admin
AGENT_PK=0x...         # the AI's hot key: can only call executePayment / deliver
COSIGNER_PK=0x...      # independent policy service: signs payment certificates
GUARDIAN_PK=0x...      # can pause, never unpause
CLIENT_PK=0x...        # Northwind (client agent hiring QED)
VENDOR_PK=0x...        # Helix Data (sells the risk model)
CREDITOR_PK=0x...      # CloudCo (holder of the ring-fenced liability)
ADVERSARY_PK=0x...     # Mallory
HONEYPOT_AGENT_PK=0x...
HONEYPOT_OWNER_PK=0x...
HONEYPOT_COSIGNER_PK=0x...

# network (omit for a local anvil chain, where deterministic dev keys are used automatically)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
GAS_LIMIT=16700000        # Sepolia: state creation is repriced and EIP-7825 caps a tx at 2^24 gas; only gas USED is charged
MAX_FEE_GWEI=0.02
PRIORITY_FEE_GWEI=0.01

# language model (optional; without it the deterministic offline brain is used and labelled as such)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# QED_OFFLINE=1
