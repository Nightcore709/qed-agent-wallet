# QED: every setting the services read, with safe placeholders (docs/DEPLOY.md, "Variables"). Copy only what you set.
# On Railway these are service variables of the one service "qed"; nothing secret is ever committed. Values marked
# SECRET go into Railway as variables (or a secret manager) and nowhere else.

# ---- required on a host ---------------------------------------------------------------------------------------------
# The one https origin the interface is served at. Passkeys and every on-chain vault are bound to it: choose it before
# the first account (a later change cannot be fixed by configuration; PRODUCTION.md section 3).
QED_PUBLIC_ORIGIN=https://qed.example.com
# Passkey relying-party id: the origin's host name (the default) or a parent domain of it; anything else stops the start.
# QED_RP_ID=qed.example.com
# Railway's health check calls from this host name; it reaches the probes only (/api/live, /api/ready, /api/health).
QED_EXTRA_HOSTS=healthcheck.railway.app
# One reverse proxy (Railway's edge) in front: the client's address is the last X-Forwarded-For entry (check H-4).
QED_TRUST_PROXY_HOPS=1
# SECRET. The key-encryption key's record (qedkek1:<id>:<key>:<check>), made once by `npm run keys:init` on the owner's
# computer and escrowed offline. The supervisor writes it to a private file outside the volume and removes it from every
# environment. Without it the service does not start (a migration could not seal its copy).
QED_KEK=qedkek1:kek_0000000000000000:REPLACE_WITH_THE_ESCROWED_RECORD:0000000000000000

# ---- set by the image (apps/qed-demo/Dockerfile); change only with a reason -----------------------------------------
# QED_DATA_DIR=/data            the volume; database, wallet data, keyrings and backups live under it
# QED_HOST=0.0.0.0              listen beyond loopback; refused unless QED_PUBLIC_ORIGIN is set
# PORT=8080                     Railway sets PORT; the API listens on it (QED_API_PORT overrides)
# QED_LOG_FORMAT=json           one JSON object per log line, redacted (server/log.ts)
# QED_RAIL_ANVIL=/usr/local/bin/anvil
# QED_AI_PROVIDER=none          no model is called until the owner approves one and its data terms (Q-051)
# QED_DELIVERY=none             no e-mail or text provider is configured; the local outbox is refused under a public origin

# ---- operations (optional) ------------------------------------------------------------------------------------------
# Production session limits (NIST SP 800-63B-4): 60 minutes idle, 24 hours in all. Defaults 720 and 10080.
QED_SESSION_IDLE_MINUTES=60
QED_SESSION_MAX_MINUTES=1440
# Sealed backup of the database every N minutes beside the running services (0: off). No automatic deletion.
QED_BACKUP_EVERY_MIN=60
# How long the engine and the API may take to stop on SIGTERM (ms). Keep it under RAILWAY_DEPLOYMENT_DRAINING_SECONDS.
QED_STOP_GRACE_MS=15000
# Railway: SIGTERM to SIGKILL buffer (its default is 0 s, which would cut every graceful stop short).
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
# "on" (default) starts the wallet service and its local test chain; "off" runs without the on-chain wallet.
# QED_WALLET=on
# 1: /api/ready also needs the wallet service (default: reported only).
# QED_READY_REQUIRES_WALLET=0
# A restore, applied once before the services start (docs/DEPLOY.md, "Restore"): the manifest's path on the volume and
# its backup id typed back. Remove both after the restore.
# QED_RESTORE_MANIFEST=/data/backups/<backup id>.manifest.json
# QED_RESTORE_CONFIRM=<backup id>
# ---- backups: retention, off-host copy and restore drills (all OFF by default; docs/DEPLOY.md section 17) ---------------
# Retention: keep the newest backup of each of the last 7 days, 4 weeks and 3 months (UTC; weeks start Monday); delete the
# rest of the `bk-*` backups on the volume (and in the off-host store). Never touches migration copies, before-restore
# copies, damaged-* folders or wallet-service archives.
# QED_BACKUP_RETENTION=off          "on" turns it on
# QED_RETAIN_DAILY=7  QED_RETAIN_WEEKLY=4  QED_RETAIN_MONTHLY=3  QED_RETAIN_HOURLY=0
# Off-host copy of the SEALED files (never plaintext) to an S3-compatible bucket you make yourself. Nothing is provisioned here.
# QED_OFFSITE=off                   "on" turns it on; the rest below is then required unless it has a default
# QED_OFFSITE_ENDPOINT=https://s3.<region>.example.com   origin only, https (http only to localhost)
# QED_OFFSITE_BUCKET=qed-backups  QED_OFFSITE_REGION=auto  QED_OFFSITE_PREFIX=qed/  QED_OFFSITE_PATH_STYLE=1
# QED_OFFSITE_ACCESS_KEY_ID=      SECRET; a key limited to this bucket and prefix: list, put, get (and delete when pruning)
# QED_OFFSITE_SECRET_ACCESS_KEY=  SECRET
# QED_OFFSITE_PRUNE=on            "off": the store keeps its own retention (lifecycle or object-lock rules); this code never deletes there
# Restore drill: every N hours restore the newest backup (and the newest off-host copy when that is on) into a scratch
# folder and run the application's own verify on it. 0 = off (default). 168 = weekly, recommended.
# QED_DRILL_EVERY_HOURS=0
# QED_MAINTENANCE_FILE=/data/MAINTENANCE   while this file exists the services are stopped and the port answers 503
# QED_HSTS=max-age=31536000; includeSubDomains   (the default under https; "off" or a longer value)
# QED_REQUESTS_PER_MINUTE=1500  per client address; may only be lowered on a host
# QED_ASK_DAILY=100  QED_ASK_MONTHLY=1000   questions to the model per workspace (no model is configured by default)

# ---- paths (defaults derived from QED_DATA_DIR by scripts/deploy/supervise.ts) --------------------------------------
# QED_DB=/data/app/qed.db  QED_RAIL_DATA=/data/app  QED_KEY_DIR=/data/keys  QED_BACKUP_DIR=/data/backups
# QED_MIGRATION_COPY_DIR=/data/app/migration-copies  QED_SECRETS_DIR=/run/qed  QED_KEY_FILE (instead of QED_KEK)
# QED_RAIL_TOKEN_FILE=/data/app/rail.token  QED_WEB_DIST=/app/apps/qed-demo/dist

# ---- the wallet service (chain/rail/main.ts lists them all; defaults are right for one container) --------------------
# QED_RAIL_PORT=5176  QED_RAIL_ANVIL_PORT=8546  QED_RAIL_ECONOMY_ANVIL_PORT=8547  QED_RAIL_URL=http://127.0.0.1:5176
# QED_RAIL_SEAL=1 (the supervisor sets it)  QED_RAIL_MODE=multi-tenant  QED_RAIL_OWNER_ACCOUNT_BUILD=declared
# Quotas and grants: QED_RAIL_QUOTA_*, QED_RAIL_GLOBAL_QUOTA_*, QED_RAIL_FAUCET_*_PAISE, QED_RAIL_WORKSPACE_DAILY_CAP_PAISE,
# QED_RAIL_ACCOUNT_DELAY_S, QED_RAIL_ACCOUNT_RECOVERY_DELAY_S, QED_RAIL_BOUNTIES, QED_RAIL_BOUNTY_*, QED_RAIL_KEEPER_BPS,
# QED_RAIL_AUTHORITY*, QED_RAIL_MAX_EPHEMERAL, QED_RAIL_HEARTBEAT_MS, QED_RAIL_GAP_S, QED_RAIL_MAX_CLOCK_LEAD_S,
# QED_RAIL_CONFIRMATIONS (2), QED_RAIL_CONFIRM_MINE (on), QED_RAIL_EARNED_* (the ceiling of the owner's signed caps)

# ---- Ask on the Anthropic API (docs/DEPLOY.md section 24; the owner's decision of 25 Nov 2026) ------------------------
# The production values the operator sets. Each question goes to the best model GET /v1/models lists for the key and the
# limits allow (demanding questions: the first of QED_AI_MODELS that fits; routine: the last); every request is recorded
# with the model that answered, its tokens and its cost, and the limits are enforced in the server from the database.
# QED_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=              SECRET; already a Railway variable. QED never prints or logs it.
# QED_AI_MODELS=claude-fable-5-2,claude-opus-5-5,claude-sonnet-5-5   best first; each must be in server/model-prices.ts
# QED_AI_BUDGET_USD=12.50         all Ask may spend on this installation; keep it below the Console balance (not readable by API)
# QED_AI_HOURLY_USD=3.00          everyone together in any 60 minutes
# QED_AI_PERSON_DAILY_USD=2.00    one person in any 24 hours
# QED_AI_SESSION_USD=1.00         one sign-in session
# QED_AI_RESERVE_USD=1.00         the end of the budget kept for the economical (last) model
# QED_AI_MAX_OUTPUT_TOKENS=8000   one request's max_tokens, thinking included
# QED_AI_MAX_INPUT_TOKENS=40000   the largest prompt sent, as estimated before the call
# QED_AI_MAX_ATTEMPTS=3           requests for one question, retries and fallbacks included
# QED_AI_TIMEOUT_MS=180000        one request; all the attempts for one question get twice this
# QED_AI_SERVER_FALLBACK=         unset: off. 1: also send the API's refusal fallback, reserving its run too
# QED_AI_MODELS_REFRESH_MIN=30    how often GET /v1/models (free) is read again; also at the API's start
# After the deploy, once: railway run --service qed -- node apps/qed-demo/scripts/ask-model-check.ts

# ---- off in this deployment: each needs the owner's separate decision -----------------------------------------------
# QED_AI_MODEL=claude-opus-5-5    the model of the command-line client path only (QED_AI_PROVIDER=claude-cli)
# QED_ADVISER_REVIEW=1 with QED_ADVISER_TOKEN=   SECRET, 32+ characters (N-006)
# QED_TLS_CERT_FILE= QED_TLS_KEY_FILE=   TLS ends at Railway's edge; not used there

# ---- never on a host: tests and local tools only ----------------------------------------------------------------------
# QED_TEST_STACK QED_TEST_CLOCK_FILE QED_TEST_SYNTHETIC_NAV_FILE QED_TEST_SYNTHETIC_PAUSE_FILE QED_AI_SCRIPT QED_PRESENTATION
# QED_RECOVERY_DELAY_SEC QED_PROTECTION_DELAY_SEC QED_RAIL_ALLOW_FAULTS QED_RAIL_FAULT QED_RAIL_BOUNTY_CONTROLS
# QED_ADVERSARIAL_TEST_SECRET QED_ADVERSARIAL_L2_SECRET QED_SECURE_COOKIES QED_WEB_PORT QED_LINK_ORIGIN QED_RAIL_ZK
