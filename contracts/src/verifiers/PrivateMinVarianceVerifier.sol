pragma solidity 0.8.26;

import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import {MessageHashUtils} from "@openzeppelin/contracts/utils/cryptography/MessageHashUtils.sol";
import {IProofVerifier} from "../interfaces/IProofVerifier.sol";

/// @notice The Groth16 verifier generated by snarkjs from circuits/private_minvar.circom.
interface IGroth16PrivateMinVariance {
    function verifyProof(
        uint256[2] calldata pA,
        uint256[2][2] calldata pB,
        uint256[2] calldata pC,
        uint256[4] calldata pubSignals
    ) external view returns (bool);
}

/// @title  PrivateMinVarianceVerifier — optimality, proven in zero knowledge
/// @notice Certifies that a provider delivered the minimum-variance long-only portfolio for a covariance
///         model that neither the chain nor the public ever sees. The provider proves, in a Groth16
///         zk-SNARK, the same KKT certificate that MinVarianceVerifier checks in public (stationarity,
///         dual feasibility, complementary slackness, convexity witness, exact budget), over:
///
///           • a covariance matrix Σ committed to by the data vendor:   Poseidon(Σ, saltΣ) = dataCommitment
///           • a portfolio w delivered privately to the client:          Poseidon(w, saltW) = weightsCommitment
///
///         The chain learns the two commitments, the certified variance wᵀΣw and the provider, nothing else.
///         Three conditions must hold for payment:
///           1. the data commitment is attested by the registered data vendor (no proofs about made-up data);
///           2. the proof is bound to the provider named in the spec (a copied proof is useless to anyone else);
///           3. the Groth16 proof verifies.
///         Theorem (docs/ALGORITHMS.md §10): acceptance implies ½wᵀΣw ≤ OPT + (2n + 3 + |ν|)·τ + O(τ²) with τ = 1e-10.
///
/// @dev    spec     = abi.encode(uint256 dataCommitment, bytes32 universe, address provider, bytes vendorSig)
///         solution = abi.encode(uint256[2] a, uint256[2][2] b, uint256[2] c, uint256 weightsCommitment, uint256 variance)
///         vendorSig is an EIP-191 signature over attestationDigest(dataCommitment, universe).
///         A spec names the provider; a client accepts a quote only if its spec names the quoting provider,
///         which ProofEscrow then holds to `msg.sender` at delivery.
contract PrivateMinVarianceVerifier is IProofVerifier {
    /// @notice Domain tag of the vendor's attestation (also in agent/src/engine/privateMinvar.ts).
    bytes32 public constant ATTESTATION_TAG = keccak256("QED Private: data attestation v1");
    /// @notice Fixed-point scale of the certified variance (wᵀΣw is reported at ONE³ = 1e36).
    uint256 public constant VARIANCE_SCALE = 1e36;
    /// @notice BN254 scalar field; every public signal must be a canonical field element.
    uint256 internal constant FIELD = 21888242871839275222246405745257275088548364400416034343698204186575808495617;

    IGroth16PrivateMinVariance public immutable groth16;
    address public immutable dataVendor;

    error UntrustedDataAttestation(address signer);
    error NotAFieldElement();
    error ProofRejected();

    constructor(IGroth16PrivateMinVariance groth16_, address dataVendor_) {
        groth16 = groth16_;
        dataVendor = dataVendor_;
    }

    function problemClass() external pure returns (string memory) {
        return "markowitz.min-variance.long-only.zk-private/v1";
    }

    /// @notice The 32 bytes the data vendor signs to attest a covariance commitment.
    function attestationDigest(uint256 dataCommitment, bytes32 universe) public view returns (bytes32) {
        return keccak256(abi.encode(ATTESTATION_TAG, block.chainid, dataCommitment, universe));
    }

    function verify(bytes calldata spec, bytes calldata solution) external view returns (bytes32 resultDigest) {
        (uint256 dataCommitment, bytes32 universe, address provider, bytes memory vendorSig) =
            abi.decode(spec, (uint256, bytes32, address, bytes));
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256 weightsCommitment, uint256 variance) =
            abi.decode(solution, (uint256[2], uint256[2][2], uint256[2], uint256, uint256));

        // 1. Garbage in is rejected before any cryptography: the data must be the vendor's.
        (address signer,,) =
            ECDSA.tryRecover(MessageHashUtils.toEthSignedMessageHash(attestationDigest(dataCommitment, universe)), vendorSig);
        if (signer != dataVendor || signer == address(0)) revert UntrustedDataAttestation(signer);

        // 2 + 3. Public signals in the circuit's order; `provider` binds the proof to its author.
        if (dataCommitment >= FIELD || weightsCommitment >= FIELD || variance >= FIELD) revert NotAFieldElement();
        uint256[4] memory pub = [weightsCommitment, variance, dataCommitment, uint256(uint160(provider))];
        if (!groth16.verifyProof(a, b, c, pub)) revert ProofRejected();

        return keccak256(abi.encode(weightsCommitment, variance));
    }
}
