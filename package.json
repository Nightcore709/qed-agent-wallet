{
  "name": "qed-agent-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "QED — proof-carrying autonomy for AI agent wallets. FinTechathon 2026 Topic F.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:contracts": "forge build",
    "test:contracts": "forge test",
    "test:ts": "node --import tsx --test agent/test/*.test.ts",
    "test": "forge test && npm run test:ts",
    "fixtures": "tsx agent/scripts/fixtures.ts",
    "local": "tsx agent/scripts/local.ts",
    "live": "tsx agent/scripts/live.ts",
    "verify": "tsx agent/scripts/verify.ts",
    "redteam": "tsx agent/scripts/redteam.ts",
    "build:app": "tsx agent/scripts/build-app.ts",
    "typecheck": "tsc --noEmit -p .",
    "resume": "tsx agent/scripts/resume.ts",
    "evidence:md": "tsx agent/scripts/evidence-md.ts",
    "fixtures:clearing": "tsx agent/scripts/fixtures-clearing.ts",
    "clearing": "tsx agent/scripts/clearing.ts",
    "local:clearing": "KEYS_FILE=/nonexistent SCRIPT=agent/scripts/clearing.ts EVIDENCE_DIR=evidence/local-clearing tsx agent/scripts/local.ts",
    "fixtures:private": "tsx agent/scripts/fixtures-private.ts",
    "local:private": "KEYS_FILE=/nonexistent SCRIPT=agent/scripts/private.ts EVIDENCE_DIR=evidence/local-private tsx agent/scripts/local.ts",
    "zk:setup": "bash circuits/setup.sh",
    "local:execute": "KEYS_FILE=/nonexistent SCRIPT=agent/scripts/execute.ts EVIDENCE_DIR=evidence/local-execution tsx agent/scripts/local.ts",
    "fixtures:execution": "tsx agent/scripts/fixtures-execution.ts",
    "demo": "node --import tsx agent/scripts/demo-server.mjs",
    "test:demo": "node --import tsx --test agent/test/demo.test.mjs",
    "test:demo:e2e": "node --import tsx --test agent/test/demo.integration.mjs agent/test/sandbox.integration.mjs",
    "test:sandbox": "node --import tsx --test agent/test/sandbox.integration.mjs"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.5",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "circomlib": "^2.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
