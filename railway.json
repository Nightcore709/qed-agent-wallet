{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/qed-demo/Dockerfile",
    "watchPatterns": [
      "apps/qed-demo/**",
      "railway.json",
      ".dockerignore",
      "docs/shared/RISK_REGISTER.md",
      "docs/research/qed-fin-infra-compliance/20261123-jurisdiction-matrix.json",
      "docs/research/qed-qa-reliability/20261124-adversarial-ask-live-original30.json",
      "docs/research/qed-qa-reliability/20261124-adversarial-ask-live-diagnosis.json",
      "docs/research/qed-qa-reliability/runs/adversarial-live-calls.tsv"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": "0",
    "drainingSeconds": "30"
  }
}
